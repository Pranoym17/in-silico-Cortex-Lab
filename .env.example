# Backend, worker, Docker, and infrastructure configuration.
# Copy this to the repository root as .env. Do not put NEXT_PUBLIC_* values here.

# Runtime and local services
ENVIRONMENT=local
DEPLOYMENT_STAGE=local
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortexlab
REDIS_URL=redis://localhost:6379/0
SSE_EVENT_BACKEND=memory

# AWS storage
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev
AWS_REGION=us-east-1
PRODUCTION_AWS_REGION=ca-central-1
PRODUCTION_AWS_ACCOUNT_ID=
S3_BUCKET_NAME=cortexlab-local
RESULTS_S3_PREFIX=results
RESULT_DOWNLOAD_EXPIRES_SECONDS=900
RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_SECONDS=2592000
SQS_QUEUE_URL=http://localhost:4566/000000000000/cortexlab-jobs

# Supabase authentication
SUPABASE_JWT_SECRET=replace-me
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWT_ISSUER=
SUPABASE_URL=
# Comma-separated backend administrator emails for moderation and featured controls.
ADMIN_EMAIL_ADDRESSES=

# Inference defaults: keep fake locally unless deliberately running a paid real Modal proof.
JOB_EXECUTION_MODE=background
INFERENCE_PROVIDER=fake
MODAL_APP_NAME=cortex-lab-tribe-inference
MODAL_FUNCTION_NAME=run
MODAL_ENVIRONMENT_NAME=
MODAL_CALL_TIMEOUT_SECONDS=300
MODAL_CALL_MAX_ATTEMPTS=2
MODAL_HF_SECRET_NAME=huggingface-secret
MODAL_AWS_SECRET_NAME=cortex-aws
TRIBE_INFERENCE_MODE=fake
TRIBE_CACHE_FOLDER=./cache
TRIBE_CHUNK_TIMESTEPS=4
TRIBE_EXPECTED_VERTEX_COUNT=20484
HF_TOKEN=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_GPU_TESTS_APPROVED=false
MODAL_GPU_BUDGET_USD=0

# Product policy and optional ML integrations
TRIBE_USAGE_MODE=research-noncommercial
STIMULUS_LICENSE_POLICY=cc0-public-domain
ANTHROPIC_API_KEY=
WANDB_API_KEY=
OPTIMIZER_PROVIDER=fake
OPTIMIZER_JOB_TTL_SECONDS=86400
OPTIMIZER_MAX_CANDIDATES_PER_JOB=100
OPTIMIZER_REAL_MAX_CANDIDATES_PER_JOB=12
ML_CACHE_ENABLED=true
ML_CACHE_TTL_SECONDS=2592000
# Set artifact mode only after training and validating the 20484 -> 512 -> 256 -> 128 -> 8 classifier.
COGNITIVE_CLASSIFIER_MODE=rules
COGNITIVE_CLASSIFIER_ARTIFACT_PATH=
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated allowlist for staging/production frontend origins. Keep localhost for local work.
FRONTEND_ORIGINS=http://localhost:3000
